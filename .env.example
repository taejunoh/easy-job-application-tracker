ENCRYPTION_SECRET="GENERATE_WITH_OPENSSL_RAND_BASE64_32"
APP_ACCESS_TOKEN="GENERATE_WITH_OPENSSL_RAND_BASE64_32"
APP_BASE_URL="<set-to-the-application-origin>"
CORS_ALLOWED_ORIGINS="<set-to-app-and-extension-origins>"
