generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id            String        @id @default(uuid())
  url           String
  jobTitle      String
  company       String
  status        String        @default("Applied")
  appliedDate   DateTime      @default(now())
  description   String?
  notes         String?
  salary        String?
  location      String?
  jobType       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  identityKey   String?       @unique
  canonicalUrl  String?
  duplicateOfId String?
  identityState String        @default("legacy_unresolved")
  duplicateOf   Application?  @relation("ApplicationDuplicates", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates    Application[] @relation("ApplicationDuplicates")

  @@index([duplicateOfId])
}

model Settings {
  id          String @id @default("singleton")
  llmProvider String @default("openai")
  apiKey      String @default("")
  linkedinUrl String @default("")
  githubUrl   String @default("")
  resumeText  String @default("")
}
